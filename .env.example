# Copy to .env (bootstrap.sh does this and generates the passwords for you).
# .env is gitignored and must never be committed.

WORDPRESS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Hostname of the blog (must match the Caddyfile)
BLOG_DOMAIN=blog.scottlaboe.com

# Where the static site repo is cloned on the host
PORTFOLIO_DIR=/srv/portfolio

# Production: leave empty. Testing before DNS cutover: local_certs
CADDY_GLOBAL_OPTS=

# S3 bucket for database/uploads backups (instance IAM role grants access; no keys on disk)
BACKUP_BUCKET=
